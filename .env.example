# Copy this file to `.env` and fill in real values there.
# `.env` is gitignored — never commit real credentials.

# --- Reasoning model (phase 5) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Gmail + Google Calendar (phases 2-3) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Desktop app type). Enable the Gmail API and Google Calendar API first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- MS Excel via Microsoft Graph (phase 4) ---
# Azure Portal -> Azure Active Directory -> App registrations -> New registration
# Grant delegated Microsoft Graph permissions: Files.ReadWrite
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# --- Optional ---
# Where the local status/audit store writes its JSON file (default: ./state)
APM_STATE_DIR=state

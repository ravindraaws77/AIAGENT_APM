# Copy this file to `.env` and fill in real values there.
# `.env` is gitignored — never commit real credentials.

# --- Reasoning model (phase 5) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional — defaults to "claude-sonnet-5" if unset (see apm/agent/reasoner.py)
ANTHROPIC_MODEL=

# --- Gmail + Google Calendar (phases 2-3) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Desktop app type). Enable the Gmail API and Google Calendar API first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Excel files: local + Google Drive (src/apm/tools/excel_file_tool.py) ---
# Local workbooks need no credentials at all -- just a file path.
# Google-Drive-hosted workbooks reuse GOOGLE_CLIENT_ID/SECRET above (same
# OAuth client, enable the Google Drive API too); requests the full
# `drive` scope (broader than ideal, but the narrower drive.file scope
# was tried first and confirmed by live testing not to work here -- it
# only covers files this app created or the user picked via a Google
# Picker, neither true for an existing file the connector is just
# pointed at -- see excel_file_tool.py's module docstring), and caches
# its own token separately from the Gmail/Calendar one
# (.google_drive_token.json, gitignored) so the two consents don't
# overwrite each other's cached scopes.
#
# The API/UI (apm.api.dependencies.get_graph) has no per-request way to
# pick a workbook -- like Gmail/Calendar's "the account", it's the one
# workbook the running server is configured for. Set AT MOST ONE of the
# two below (setting both is a startup error -- ambiguous which to use):
#   - a local file: APM_EXCEL_WORKBOOK_PATH=/path/to/workbook.xlsx
#   - a Drive file: APM_EXCEL_DRIVE_FILE_ID=<id> (a literal file id, not
#     a name -- find it with `python scripts/excel_file_demo.py gdrive --list`)
# Leave both unset to run without Excel at all -- the dashboard's free-text
# "Ask APM" box still recognizes spreadsheet-sounding requests (see
# apm/agent/intent.py's excel_query), it just won't have a workbook to
# actually check.
APM_EXCEL_WORKBOOK_PATH=
APM_EXCEL_DRIVE_FILE_ID=

# --- MS Excel via Microsoft Graph (phase 4) ---
# Azure Portal -> Azure Active Directory -> App registrations -> New registration.
# No redirect URI needed — this MVP uses MSAL's device-code flow (public
# client), so MS_GRAPH_CLIENT_SECRET below is not required for it; it's
# reserved for a future confidential-client (server-side) flow.
# Grant delegated Microsoft Graph permission: Files.Read (read-only for now).
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# --- Optional ---
# Where the local status/audit store writes its JSON file (default: ./state)
APM_STATE_DIR=state
# NiceGUI dashboard (phase 6b): where it finds the FastAPI backend, and
# which port it serves on. Defaults shown below.
APM_API_BASE_URL=http://localhost:8000
APM_UI_PORT=8080
